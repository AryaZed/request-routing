{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Queue": {
    "UrgentHeadStart": "00:30:00",
    "SweepInterval": "00:00:30"
  },
  "Database": {
    "MigrateOnStartup": false
  }
}
